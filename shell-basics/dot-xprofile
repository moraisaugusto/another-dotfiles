#!/bin/sh
#
# ~/.xprofile
#
# X11 ONLY. Sourced by the display manager's X session wrapper (SDDM's
# /usr/share/sddm/scripts/Xsession and LightDM's /etc/lightdm/Xsession) and by
# `startx`. It is NOT read in a Wayland session (sway).
#
# UI scaling lives in ~/.config/scaling.env -- do not hardcode GDK_SCALE here.

# Single source of truth for UI scale (also sourced by ~/.config/zsh/.zshenv).
[ -f "$HOME/.config/scaling.env" ] && . "$HOME/.config/scaling.env"

# Load X resources (Xft.dpi, cursor size, ...).
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

## resolution
#xrandr --output DP-0 --off --output DP-0 --mode 3840x2160 --pos 0x0 --dpi 192 --rate 120.00 --rotate normal
xrandr --output DP-4 --primary --mode 3840x2160 --rate 120 --pos 0x0 --rotate normal --output DP-2 --off

##
# X
##
# Theme handled by gtk-3.0/gtk-4.0 settings.ini (Arc-Dark).
export GTK_MODULES=canberra-gtk-module
export QT_QPA_PLATFORMTHEME="qt5ct"

# custom fonts
xset +fp /home/augusto/.fonts/tewi
xset +fp /home/augusto/.fonts/tamzen
xset +fp /home/augusto/.fonts/siji
xset +fp /home/augusto/.fonts/terminus
xset +fp /home/augusto/.fonts/haxor
xset fp rehash

# HiDPI: GDK_SCALE, GDK_DPI_SCALE, QT_SCALE_FACTOR and XCURSOR_SIZE are set in
# ~/.config/scaling.env (UI_SCALE). Xft.dpi is derived in ~/.xsessionrc (SDDM)
# and kept in ~/.Xresources for LightDM/startx.
