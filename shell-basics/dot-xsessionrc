#!/bin/sh
#
# ~/.xsessionrc
#
# X11 ONLY, and only read by SDDM's X session wrapper
# (/usr/share/sddm/scripts/Xsession), AFTER ~/.Xresources has been merged.
#
# LightDM and startx do NOT read this file. For them the same DPI/cursor values
# are kept (hardcoded) in ~/.Xresources -- keep both in sync with UI_SCALE in
# ~/.config/scaling.env.

[ -f "$HOME/.config/scaling.env" ] && . "$HOME/.config/scaling.env"

xrdb -merge <<EOF
Xft.dpi: $((96 * UI_SCALE))
rofi.dpi: $((96 * UI_SCALE))
Xcursor.size: $((24 * UI_SCALE))
EOF
