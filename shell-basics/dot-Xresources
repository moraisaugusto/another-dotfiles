! ~/.Xresources
!
! X11 ONLY. Merged by xrdb in X11 sessions (SDDM, LightDM, startx).
! Wayland/sway does NOT merge this automatically; add
!     exec xrdb -merge ~/.Xresources
! to the sway config if XWayland apps need these resources.
!
! The DPI/cursor values below are duplicated in ~/.xsessionrc, where SDDM
! derives them from UI_SCALE in ~/.config/scaling.env. LightDM and startx do
! not read ~/.xsessionrc, so keep this file in sync with UI_SCALE.

!### Common Configs
#include ".Xresources.d/meta-keys-fixed-nvim"
!#include ".Xresources.d/rofi"

!
!### Home Configs
!
! styles
#include ".Xresources.d/rxvt-unicode-home-4k"

! Themes
#include ".Xresources.d/schemes/gruvbox_material_dark"

! 4k Resolution
*.dpi: 192
Xft.dpi: 192
rofi.dpi: 192
Xcursor.size: 48
!
!### Work Configs
!
! styles
!#include ".Xresources.d/rxvt-unicode-work"

! Themes
!#include ".Xresources.d/schemes/dracula"

! 2k Resolution
!*.dpi: 120
!Xft.dpi: 120
!rofi.dpi: 120
!Xcursor.size: 18


!Xft.autohint: 0
!Xft.lcdfilter: lcddefault
!Xft.hintstyle: hintnone
!Xft.hinting: 1
!Xft.antialias: 1
!Xft.rgba: rgb
