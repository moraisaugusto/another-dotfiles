{
  "$schema": "https://app.kilo.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami *": "allow",
      "printenv *": "allow",
      "man *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "*>*": "ask"
    },
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "codesearch": "allow",
    "*": {
      "*": "allow"
    }
  },
  "mcp": {
    "sesame": {
      "type": "local",
      "command": ["/Users/amorais/.local/share/sesame/venv/bin/sesame"],
      "enabled": true
    }
  }
}
