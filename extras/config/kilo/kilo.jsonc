{
  "$schema": "https://app.kilo.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami *": "allow",
      "printenv *": "allow",
      "man *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "*>*": "ask",
      "git rev-parse *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git branch *": "allow",
      "find *": "allow",
      "git remote -v *": "allow",
      "git merge-base *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "sort *": "allow",
      "awk *": "allow",
      "conda *": "allow",
      "sed *": "allow",
      "git --no-pager *": "allow",
      "readlink *": "allow",
      "curl *": "allow",
      "python3 *": "allow",
      "git ls-tree *": "allow",
      "git check-ignore *": "allow",
      "pnpm lint *": "allow",
      "pnpm --filter *": "allow",
      ".venv/bin/python *": "allow",
      "git -c *": "allow",
      "git show-ref *": "allow",
      "git ls-files *": "allow",
      "paste *": "allow",
      "rm *": "allow",
      "v4/env/bin/node *": "allow",
      "ps *": "allow",
      "mdfind *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/Users/amorais/Development/anaconda-desktop-bridge/*": "allow",
      "/Users/amorais/Development/agentic-desktop/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/ys/0c_vcpvs5vx8bzf33h8npt7h0000gp/T/kilo/timeline/*": "allow",
      "/private/var/folders/ys/0c_vcpvs5vx8bzf33h8npt7h0000gp/T/kilo/timeline/*": "allow",
      "/Users/amorais/Development/docs/360-reviews/*": "allow",
      "/Users/amorais/Development/interviews/*": "allow",
      "/Users/amorais/Development/assistant-api/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "codesearch": "allow",
    "*": {
      "*": "allow"
    }
  },
  "mcp": {
    "sesame": {
      "type": "local",
      "command": ["/Users/amorais/.local/share/sesame/venv/bin/sesame"],
      "enabled": true
    }
  }
}
