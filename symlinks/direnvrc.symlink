# direnv evaluates this file with bash.

# Function: _abs_path
# Description: Pure-shell absolute path (no coreutils/grealpath needed).
#   Named to avoid shadowing the system `realpath`.
_abs_path() {
  [[ $1 = /* ]] && echo "$1" || echo "$PWD/${1#./}"
}

# Function: custom_anaconda
# Description: This function creates a custom Project Layout for conda
#
# For Conda environment
# example of .envrc file
#   export VIRTUAL_ENV=.condaenv
#   layout custom_anaconda python=3.8.13
#
# VIRTUAL_ENV may be either the name of an existing conda env or a path.
# If it is a path that does not exist yet, the env is created from
# ./environment.yml when present, otherwise with the given python version.
# If VIRTUAL_ENV is unset, .direnv/conda-env is used.
#
# Parameters:
#   $1 - python version. e.g. python=3.8.13 (optional)
#   if not used, the default version will be used
# Returns: None
layout_custom_anaconda() {
  local python_version="${1:-python=3.11}"

  if ! has conda; then
    log_error "conda not found on PATH"
    return 1
  fi
  eval "$(conda shell.bash hook)"

  if [[ -n $VIRTUAL_ENV ]] && conda env list | awk -v n="$VIRTUAL_ENV" '$1 == n {found=1} END {exit !found}'; then
    # Named env that already exists
    conda activate "$VIRTUAL_ENV"
    return
  fi

  local env_path
  if [[ -n $VIRTUAL_ENV ]]; then
    env_path=$(_abs_path "$VIRTUAL_ENV")
  else
    env_path=$PWD/.direnv/conda-env
  fi

  if [[ ! -d $env_path ]]; then
    if [[ -f environment.yml ]]; then
      log_status "no conda env found; creating $env_path from environment.yml"
      conda env create -f environment.yml -p "$env_path" || {
        log_error "failed to create conda env from environment.yml"
        return 1
      }
    else
      log_status "no conda env found; creating $env_path ($python_version)"
      conda create -y -p "$env_path" "$python_version" || {
        log_error "failed to create conda env $env_path"
        return 1
      }
    fi
  fi

  conda activate "$env_path"
}

# Function: python-venv
# Description: This function creates a custom virtual environment Layout for python
#
# For venv environment
#   export VIRTUAL_ENV=.env
#   layout python-venv python3.11
#
#
# Parameters:
#   $1 - python version. e.g. python3 (optional)
#   if not used, the default version will be used
# Returns: None
layout_python-venv() {
    local python=${1:-python3}
    [[ $# -gt 0 ]] && shift
    unset PYTHONHOME
    if [[ -n $VIRTUAL_ENV ]]; then
        VIRTUAL_ENV=$(_abs_path "${VIRTUAL_ENV}")
    else
        local python_version
        python_version=$("$python" -c "import platform; print(platform.python_version())")
        if [[ -z $python_version ]]; then
            log_error "Could not detect Python version"
            return 1
        fi
        VIRTUAL_ENV=$PWD/.direnv/python-venv-$python_version
    fi
    export VIRTUAL_ENV
    if [[ ! -d $VIRTUAL_ENV ]]; then
        log_status "no venv found; creating $VIRTUAL_ENV"
        "$python" -m venv "$VIRTUAL_ENV"
    fi
    PATH_add "$VIRTUAL_ENV/bin"
}
