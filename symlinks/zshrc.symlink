# ── DEBUG (comment out when done) ────────────────────────────────────────────
# zmodload zsh/zprof

# ── PATH ─────────────────────────────────────────────────────────────────────
export PATH="$HOME/.bin:$HOME/bin:/usr/local/bin:/usr/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/opt/sqlite/bin:$HOME/.ana/bin:$PATH"
# Consolidate all PATH exports into ONE line — multiple export PATH=… calls are redundant

# ── OH-MY-ZSH ────────────────────────────────────────────────────────────────
# Theme is linked by scripts/mac-link.sh:
#   ~/.oh-my-zsh/themes/augusto-default.zsh-theme -> extras/oh-my-zsh/custom/themes/
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="augusto-default"

# FIX 1: Disable compaudit (saves ~24ms — the security check is noisy and not useful day-to-day)
ZSH_DISABLE_COMPFIX=true

# FIX 2: Disable auto-update check (saves ~16ms)
zstyle ':omz:update' mode disabled

# TMUX
ZSH_TMUX_AUTOSTART=true
ZSH_TMUX_AUTOCONNECT=true
ZSH_TMUX_AUTOSTART_ONCE=true
ZSH_TMUX_FIXTERM=true

# FIX 3: Trim plugins — each plugin adds sourcing time.
# Removed: emoji-clock, battery, nmap (rarely needed interactively)
# Removed: docker, docker-compose (completions are heavy; add back only if you use tab-complete often)
plugins=(git colored-man-pages tmux tmuxinator extract web-search)

source $ZSH/oh-my-zsh.sh

# ── LOCALE / EDITOR ──────────────────────────────────────────────────────────
export LANG=en_US.UTF-8
export EDITOR="${SSH_CONNECTION:+vim}${SSH_CONNECTION:-nvim}"

# ── ALIASES ──────────────────────────────────────────────────────────────────
alias vi=nvim
alias restart-docker="osascript -e 'quit app \"Docker\"' && open -a Docker"
alias free-mac='vm_stat | perl -ne '"'"'/page size of (\d+)/ and $size=$1; /Pages\s+([^:]+)[^\d]+(\d+)/ and printf("%-16s % 16.2f Mi\n", "$1:", $2 * $size / 1048576);'"'"''

# ── POMODORO ─────────────────────────────────────────────────────────────────
POMODORO_BEFORE_LONG_BREAK=4
alias pause_sound="mpv $HOME/.dotfiles/extras/sounds/pause.mp3 > /dev/null 2>&1"
alias work="timer 25m -n 'Work' && pause_sound && notify-send -u low 'Pomodoro' 'Work Timer is up! Take a Break 😊'"
alias rest="timer 5m -n 'Rest' && pause_sound && notify-send -u low 'Pomodoro' 'Break is over! Get back to work 😬'"
alias long_rest="timer 15m -n 'Long Rest' && pause_sound && notify-send -u low 'Pomodoro' 'Long Break is over! Get back to work 😬'"
alias pomodoro='repeat $POMODORO_BEFORE_LONG_BREAK {work && rest} && long_rest'

start_work() { repeat $1 {work; rest} && rest }

# ── MISE ─────────────────────────────────────────────────────────────────────
eval "$(mise activate zsh --shims)"

# ── DIRENV ───────────────────────────────────────────────────────────────────
eval "$(direnv hook zsh)"

# ── CONDA (FIX 5: lazy-load — only initialise when you actually call conda) ──
# Must match the `python` version in extras/config/mise/config.toml.
CONDA_ROOT="$HOME/.local/share/mise/installs/python/anaconda3-2026.07-1"
conda() {
  unfunction conda
  __conda_setup="$("$CONDA_ROOT/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    [ -f "$CONDA_ROOT/etc/profile.d/conda.sh" ] \
      && source "$CONDA_ROOT/etc/profile.d/conda.sh" \
      || export PATH="$CONDA_ROOT/bin:$PATH"
  fi
  unset __conda_setup
  conda "$@"
}

# ── SECRETS (machine-local, not tracked) ─────────────────────────────────────
# ANACONDA_ORG_DOWNLOAD_TOKEN, PIP_EXTRA_INDEX_URL, AWS_PROFILE, AWS_REGION, ANTHROPIC_MODEL
[ -f ~/.secrets ] && source ~/.secrets

# ── ZOXIDE ───────────────────────────────────────────────────────────────────
eval "$(zoxide init zsh)"

# ── VIRTUAL ENV INDICATOR ────────────────────────────────────────────────────
show_virtual_env() {
  [[ -n "$VIRTUAL_ENV" && -n "$DIRENV_DIR" ]] && echo "($(basename $VIRTUAL_ENV))"
}
export show_virtual_env

# ── LOCAL ENV ────────────────────────────────────────────────────────────────
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# ── ALIASES FILE ─────────────────────────────────────────────────────────────
[ -f ~/.zshAlias ] && source ~/.zshAlias

# ── KILO ─────────────────────────────────────────────────────────────────────
export PATH="$HOME/.kilo/bin:$PATH"

# ── PNPM ─────────────────────────────────────────────────────────────────────
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# ── DEBUG (uncomment zmodload at top AND this line together) ─────────────────
# zprof
