{
	"mode": "dock",
	"position": "top",
	"layer": "top",
	"width": 0,
	"height": 0,
	"margin": 0,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/sway/*.jsonc",
		"~/.config/waybar/modules/optional/wireplumber.jsonc",
		// "~/.config/waybar/modules/hyprland/*.jsonc",
		// "~/.config/waybar/modules/optional/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
    "custom/info-tailscale",
    "custom/mullvad-vpn",

		"custom/left#bg_1",
		"sway/workspaces",
		"custom/right#bg_1"

		// "hyprland/window"
	],

	"modules-center": [
		"sway/window",

		// "custom/left#bg_1",
		// "temperature",
		//
		// "custom/left#bg_2",
		// "memory",
		//
		// "custom/left#bg_3",
		// "cpu",
		// "custom/left_inverse#bg_3",

		"clock#date",
		"clock#time"

		// "custom/right_inverse#bg_3",
		// "idle_inhibitor",
		// "custom/right#bg_3",
		//
		// "custom/right#bg_2",
		//
		// "custom/right#bg_1"
	],

	"modules-right": [
		"custom/left#bg_1",
		"group/wireplumber",
		// "group/pulseaudio",

		// "custom/left#bg_2",
		// "backlight",

		// "custom/left#bg_3",
		// "custom/left_inverse#bg_3",

		"custom/display",
    "custom/power",
    "tray"
	],

  "sway/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
      "default": ""
    }
  },

  "tray": {
    "icon-size": 28,
    "spacing": 10
  }
}
