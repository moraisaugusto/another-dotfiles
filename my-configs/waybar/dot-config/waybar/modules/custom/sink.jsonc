{
  "custom/sink": {
    "exec": "~/.config/waybar/scripts/sink.sh",
    "markup": true,
    "interval": 1,
    "on-click": "~/.config/waybar/scripts/volume output mute",
    "on-click-middle": "~/.config/waybar/scripts/volume sink",
    "on-click-right": "exec pavucontrol",
    "on-scroll-up": "~/.config/waybar/scripts/volume output up",
    "on-scroll-down": "~/.config/waybar/scripts/volume output down",
    "tooltip": false
  }
}
