{
	"group/wireplumber": {
		"modules": [
			"custom/sink",
			"wireplumber#input"
		],
		"orientation": "horizontal",
		"drawer": {
			"transition-left-to-right": false
		}
	},

	"wireplumber#input": {
		"node-type": "Audio/Source",
		"format": "󰍬 {volume}%",
		"format-muted": "󰍭 {volume}%",
		"min-length": 8,
		"max-length": 8,
		"on-click": "~/.config/waybar/scripts/volume input mute",
		"on-click-right": "exec pavucontrol",
		"on-scroll-up": "~/.config/waybar/scripts/volume input up",
		"on-scroll-down": "~/.config/waybar/scripts/volume input down",
		"tooltip-format": "Device: {node_name}"
	}
}
