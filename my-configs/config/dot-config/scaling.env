# ~/.config/scaling.env -- single source of truth for UI scaling.
#
# Sourced from ~/.config/zsh/.zshenv, so it applies to every session
# (SDDM/LightDM X11 and Wayland) and therefore to every app launched from it.
#
# 96 dpi is the "100%" baseline: Xft.dpi = 96 * UI_SCALE (UI_SCALE=2 -> 192).

UI_SCALE=2

# Cursor size, shared by X11 and Wayland.
export XCURSOR_SIZE=$((24 * UI_SCALE))

# Qt high-DPI support (the actual factor differs per session type, see below).
export QT_ENABLE_HIGHDPI_SCALING=1

case "${XDG_SESSION_TYPE:-${DESKTOP_SESSION:-x11}}" in
  x11)
    # GTK on X11 needs an explicit integer scale factor.
    export GDK_SCALE=$UI_SCALE

    # Xft.dpi is 96*UI_SCALE for non-GTK X11 apps (rofi, urxvt, ...). Cancel
    # that doubling for GTK fonts so text is not scaled twice.
    export GDK_DPI_SCALE=$(awk "BEGIN{printf \"%g\", 1/$UI_SCALE}")

    # Qt on X11 has no compositor telling it the scale.
    export QT_AUTO_SCREEN_SCALE_FACTOR=0
    export QT_SCALE_FACTOR=$UI_SCALE
    export QT_FONT_DPI=96
    ;;
  wayland*)
    # On Wayland the compositor sets the scale (sway: `output <name> scale
    # $UI_SCALE`, applied by ~/.config/sway/apply-scale.sh). Setting these here
    # would scale everything twice.
    unset GDK_SCALE GDK_DPI_SCALE
    unset QT_AUTO_SCREEN_SCALE_FACTOR QT_SCALE_FACTOR QT_FONT_DPI
    ;;
esac
